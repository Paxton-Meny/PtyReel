# The README hero. Nothing here needs anything beyond a shell and coreutils.
Output demos/out/hello.svg
Set Title "ptyreel"
Set Width 900
Set Height 420
Set TypingSpeed 45ms
Set LoopDelay 2500ms

Type "echo 'recorded in a real pty, rendered as one svg'"
Enter
Sleep 1200ms

Type "uname -s && wc -c < /etc/hostname"
Enter
Sleep 1500ms
